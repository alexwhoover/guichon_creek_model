#########################################################################
:FileType          rvh ASCII Raven 4.1
:CreationDate      2026-11-06
#
# Raven HBV-EC emulation - WATERSHED / HRU FILE
#------------------------------------------------------------------------

#------------------------------------------------------------------------
# Subbasins (from GIS delineation, 2026-11-09)
#   1 Guichon_BelowSolar : 109.15 km2 incremental (185.05 km2 total), outlet just below
#                          the solar site (main output; model outlet)
#   3 Guichon_08LG056    : 75.90 km2 headwater, outlet = WSC 08LG056 above the Tunkwa Lake
#                          diversion (natural flow, RHBN; main calibration target).
#                          Split out of subbasin 1 on 2026-11-12 using the CLRH catchments:
#                          data/scripts/split_08LG056_subbasin.R -> data/processed/hru_split_08LG056.csv
# Subbasin 2 (Guichon_08LG041, to the regulated WSC 08LG041 gauge at the Mamit Lake outlet,
# HRUs 6-11 including solar HRU 6, and the Mamit Lake reservoir) was removed on 2026-11-12:
# it is downstream of the subbasin 1 outlet, so it does not affect the result. HRU IDs are
# kept as they were (1-5, 12-15) to match the GIS layers.
# REACH_LENGTH is not used while :Routing is ROUTE_NONE. Subbasin 1's value still includes
# the 17.3 km above 08LG056, so shorten it if channel routing is switched on.
#------------------------------------------------------------------------
:SubBasins
  :Attributes   NAME                 DOWNSTREAM_ID   PROFILE   REACH_LENGTH   GAUGED
  :Units        none                 none            none      km             none
  1,            Guichon_BelowSolar,  -1, NONE,              31.983,        1
  3,            Guichon_08LG056,     1,  NONE,              17.3,          1
:EndSubBasins

:SubBasinProperties
  :Parameters,   TIME_CONC,   TIME_TO_PEAK
  :Units     ,           d,              d
             1,        2.0,            1.0
             3,        1.3,            0.65     # Guess: subbasin 1 value x sqrt(75.9/185)
:EndSubBasinProperties

:HRUs
  :Attributes  AREA     ELEVATION  LATITUDE  LONGITUDE  BASIN_ID  LAND_USE_CLASS  VEG_CLASS    SOIL_PROFILE  AQUIFER_PROFILE  TERRAIN_CLASS  SLOPE  ASPECT
  :Units       km2      m          deg       deg        none      none            none         none          none             none           deg    deg
  # Subbasin 1: Guichon_BelowSolar (HRUs 2-5 are the parts of each band below 08LG056)
  1,           3.237,   1215.0,    50.5481,  -120.8366, 1,        MIX20_LU,       MIX20_VEG,    DEFAULT_P,    [NONE],          [NONE],        0.0,   0.0   # SB1 solar
  2,           37.193,  1150.8,    50.5686,  -120.8767, 1,        MIX20_LU,       MIX20_VEG,    DEFAULT_P,    [NONE],          [NONE],        0.0,   0.0   # SB1 1000-1200
  3,           31.973,  1292.4,    50.5721,  -120.9211, 1,        MIX20_LU,       MIX20_VEG,    DEFAULT_P,    [NONE],          [NONE],        0.0,   0.0   # SB1 1200-1400
  4,           25.580,  1478.3,    50.5523,  -120.9631, 1,        MIX20_LU,       MIX20_VEG,    DEFAULT_P,    [NONE],          [NONE],        0.0,   0.0   # SB1 1400-1600
  5,           10.927,  1692.1,    50.5734,  -120.9927, 1,        MIX20_LU,       MIX20_VEG,    DEFAULT_P,    [NONE],          [NONE],        0.0,   0.0   # SB1 1600+
  # Subbasin 3: Guichon_08LG056 (the parts of SB1 bands 2-5 above the gauge)
  12,          2.135,   1185.8,    50.6167,  -120.9194, 3,        MIX20_LU,       MIX20_VEG,    DEFAULT_P,    [NONE],          [NONE],        0.0,   0.0   # SB3 1000-1200
  13,          39.078,  1307.7,    50.6355,  -120.9651, 3,        MIX20_LU,       MIX20_VEG,    DEFAULT_P,    [NONE],          [NONE],        0.0,   0.0   # SB3 1200-1400
  14,          22.488,  1493.9,    50.6420,  -121.0005, 3,        MIX20_LU,       MIX20_VEG,    DEFAULT_P,    [NONE],          [NONE],        0.0,   0.0   # SB3 1400-1600
  15,          12.203,  1743.1,    50.6030,  -121.0333, 3,        MIX20_LU,       MIX20_VEG,    DEFAULT_P,    [NONE],          [NONE],        0.0,   0.0   # SB3 1600+
:EndHRUs

:HRUGroup SB1_HRUs
  1,2,3,4,5
:EndHRUGroup

:HRUGroup SB3_HRUs
  12,13,14,15
:EndHRUGroup

:HRUGroup SOLAR_SITE
  1
:EndHRUGroup
