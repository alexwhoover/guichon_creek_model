#########################################################################
:FileType          rvh ASCII Raven 4.1
:CreationDate      2026-11-06
#
# Raven HBV-EC emulation - WATERSHED / HRU FILE
#------------------------------------------------------------------------

#------------------------------------------------------------------------
# Subbasins (from GIS delineation, 2026-11-09)
#   1 Guichon_BelowSolar : 109.15 km2 incremental (185.05 km2 total), outlet just below
#                          the solar site (main output)
#   2 Guichon_08LG041    : 620.72 km2 incremental, outlet = WSC 08LG041 (regulated; calibration)
#   3 Guichon_08LG056    : 75.90 km2 headwater, outlet = WSC 08LG056 above the Tunkwa Lake
#                          diversion (natural flow, RHBN; main calibration target).
#                          Split out of subbasin 1 on 2026-11-12 using the CLRH catchments:
#                          data/scripts/split_08LG056_subbasin.R -> data/processed/hru_split_08LG056.csv
# REACH_LENGTH is not used while :Routing is ROUTE_NONE. Subbasin 1's value still includes
# the 17.3 km above 08LG056, so shorten it if channel routing is switched on.
#------------------------------------------------------------------------
:SubBasins
  :Attributes   NAME                 DOWNSTREAM_ID   REACH_LENGTH   GAUGED
  :Units        none                 none            km             none
  1,            Guichon_BelowSolar,  2,              31.983,        1
  2,            Guichon_08LG041,     -1,             69.797,        1
  3,            Guichon_08LG056,     1,              17.3,          1
:EndSubBasins

:SubBasinProperties
  :Parameters,   TIME_CONC,   TIME_TO_PEAK
  :Units     ,           d,              d
             1,        2.0,            1.0
             2,        3.0,            1.5
             3,        1.3,            0.65     # Guess: subbasin 1 value x sqrt(75.9/185)
:EndSubBasinProperties

:HRUs
  :Attributes  AREA     ELEVATION  LATITUDE  LONGITUDE  BASIN_ID  LAND_USE_CLASS  VEG_CLASS    SOIL_PROFILE  AQUIFER_PROFILE  TERRAIN_CLASS  SLOPE  ASPECT
  :Units       km2      m          deg       deg        none      none            none         none          none             none           deg    deg
  # Subbasin 1: Guichon_BelowSolar (HRUs 2-5 are the parts of each band below 08LG056)
  1,           3.237,   1215.0,    50.5481,  -120.8366, 1,        SITE_PRE_LU,    SITE_PRE_VEG, DEFAULT_P,    [NONE],          [NONE],        0.0,   0.0   # SB1 solar
  2,           37.193,  1150.8,    50.5686,  -120.8767, 1,        OPEN_LU,        OPEN_VEG,     DEFAULT_P,    [NONE],          [NONE],        0.0,   0.0   # SB1 1000-1200
  3,           31.973,  1292.4,    50.5721,  -120.9211, 1,        OPEN_LU,        OPEN_VEG,     DEFAULT_P,    [NONE],          [NONE],        0.0,   0.0   # SB1 1200-1400
  4,           25.580,  1478.3,    50.5523,  -120.9631, 1,        OPEN_LU,        OPEN_VEG,     DEFAULT_P,    [NONE],          [NONE],        0.0,   0.0   # SB1 1400-1600
  5,           10.927,  1692.1,    50.5734,  -120.9927, 1,        OPEN_LU,        OPEN_VEG,     DEFAULT_P,    [NONE],          [NONE],        0.0,   0.0   # SB1 1600+
  # Subbasin 2: Guichon_08LG041
  6,           0.751,   1231.5,    50.5383,  -120.8299, 2,        SITE_PRE_LU,    SITE_PRE_VEG, DEFAULT_P,    [NONE],          [NONE],        0.0,   0.0   # SB2 solar
  7,           11.783,  973.5,     50.4176,  -120.8132, 2,        MIX20_LU,       MIX20_VEG,    DEFAULT_P,    [NONE],          [NONE],        0.0,   0.0   # SB2 <1000
  8,           83.250,  1122.0,    50.4618,  -120.9062, 2,        MIX20_LU,       MIX20_VEG,    DEFAULT_P,    [NONE],          [NONE],        0.0,   0.0   # SB2 1000-1200
  9,           250.091, 1308.7,    50.4520,  -120.6199, 2,        MIX20_LU,       MIX20_VEG,    DEFAULT_P,    [NONE],          [NONE],        0.0,   0.0   # SB2 1200-1400
  10,          235.559, 1484.5,    50.5284,  -120.6600, 2,        MIX20_LU,       MIX20_VEG,    DEFAULT_P,    [NONE],          [NONE],        0.0,   0.0   # SB2 1400-1600
  11,          38.729,  1669.7,    50.5328,  -120.5893, 2,        MIX20_LU,       MIX20_VEG,    DEFAULT_P,    [NONE],          [NONE],        0.0,   0.0   # SB2 1600+
  # Subbasin 3: Guichon_08LG056 (the parts of SB1 bands 2-5 above the gauge)
  12,          2.135,   1185.8,    50.6167,  -120.9194, 3,        OPEN_LU,        OPEN_VEG,     DEFAULT_P,    [NONE],          [NONE],        0.0,   0.0   # SB3 1000-1200
  13,          39.078,  1307.7,    50.6355,  -120.9651, 3,        OPEN_LU,        OPEN_VEG,     DEFAULT_P,    [NONE],          [NONE],        0.0,   0.0   # SB3 1200-1400
  14,          22.488,  1493.9,    50.6420,  -121.0005, 3,        OPEN_LU,        OPEN_VEG,     DEFAULT_P,    [NONE],          [NONE],        0.0,   0.0   # SB3 1400-1600
  15,          12.203,  1743.1,    50.6030,  -121.0333, 3,        OPEN_LU,        OPEN_VEG,     DEFAULT_P,    [NONE],          [NONE],        0.0,   0.0   # SB3 1600+
:EndHRUs

:Reservoir Mamit_Lake
  :SubBasinID        2
  :WeirCoefficient   0.6         # Guess
  :CrestWidth        10.0        # Guess
  :MaxDepth          5.0         # Guess
  :LakeArea          2030000.0   # From GIS
:EndReservoir

