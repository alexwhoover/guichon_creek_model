#########################################################################
:FileType          rvt ASCII Raven 4.1
:CreationDate      2026-11-06
#
# Raven HBV-EC emulation - TIME SERIES FILE (met gauge + observed flow)
#------------------------------------------------------------------------

:Gauge HighlandValleyLornex
  # ECCC HIGHLAND VALLEY LORNEX, Climate ID 1123469 (gaps filled from KAMLOOPS A)
  :Latitude     50.4667
  :Longitude    -121.0167
  :Elevation    1268.0      # m - matters: temperature & precip are lapsed from here to each HRU

  # Gauge under-catch corrections (calibrated multipliers, start at 1.0)
  :RainCorrection   1.0     # RFCF (HBV_PARA_20)
  :SnowCorrection   1.0     # SFCF (HBV_PARA_21)

  # Monthly normals AT THIS GAUGE (required by PET_FROMMONTHLY), Oct 1982 - Sep 2011,
  # from the gap-filled record (data/write_met_rvt.R -> data/lornex_monthly_normals.csv)
  #   Temperature = mean of (Tmax+Tmin)/2, deg C
  #   Evaporation = Hargreaves PET, mm/DAY (not mm/month); ~713 mm/yr
  #                         Jan    Feb    Mar    Apr    May    Jun    Jul    Aug    Sep    Oct    Nov    Dec
  :MonthlyAveTemperature,  -4.8,  -3.2,  -0.1,   3.8,   8.3,  11.8,  15.2,  14.9,  10.7,   4.8,  -1.9,  -6.0
  :MonthlyAveEvaporation,  0.30,  0.57,  1.13,  2.07,  3.18,  3.90,  4.40,  3.71,  2.36,  1.09,  0.40,  0.22

  # Daily forcing series
  :RedirectToFile data/met_daily.rvt
:EndGauge

# Observed streamflow at WSC 08LG041 = outlet of subbasin 2 (Guichon_08LG041)
:RedirectToFile data/obs_flow_daily.rvt
